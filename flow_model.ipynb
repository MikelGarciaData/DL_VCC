        "    print(f\"Predicted shape: {predicted_cells.shape}\")\n",
        "    print(\"Done!\")\n",
        "\n",
        "def predict_perturbation(model, x_control, gene_vector):\n",
        "    \"\"\"\n",
        "    Simulates the ODE from t=0 (Control) to t=1 (Perturbed)\n",
        "    guided by the gene_vector.\n",
        "    \"\"\"\n",
        "    model.eval()\n",
        "    x_t = x_control.clone()\n",
        "    dt = 0.05 # Step size\n",
        "    steps = int(1.0 / dt)\n",
        "\n",
        "    # Broadcast gene vector to batch size\n",
        "    batch_size = x_control.shape[0]\n",
        "    y_vec_batch = gene_vector.unsqueeze(0).repeat(batch_size, 1) # (B, 200)\n",
        "\n",
        "    with torch.no_grad():\n",
        "        for i in range(steps):\n",
        "            t_val = i * dt\n",
        "            t_batch = torch.full((batch_size, 1), t_val, device=device)\n",
        "\n",
        "            # Predict velocity\n",
        "            velocity = model(x_t, t_batch, y_vec_batch)\n",
        "\n",
        "            # Euler step\n",
        "            x_t = x_t + velocity * dt\n",
        "\n",
        "    return x_t\n",
