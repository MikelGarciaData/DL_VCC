        "import torch\n",
        "import torch.nn as nn\n",
        "import numpy as np\n",
        "import scanpy as sc\n",
        "import math\n",
        "from tqdm import tqdm\n",
        "\n",
        "# Set device\n",
        "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
        "print(f\"Using device: {device}\")\n",
        "\n",
        "# ==========================================\n",
        "# 1. Neural Network Components (AdaLN + Transformer)\n",
        "# ==========================================\n",
        "\n",
        "class SinusoidalPosEmb(nn.Module):\n",
        "    \"\"\"Encodes the time step 't' into a vector.\"\"\"\n",
        "    def __init__(self, dim):\n",
        "        super().__init__()\n",
        "        self.dim = dim\n",
        "\n",
        "    def forward(self, x):\n",
        "        device = x.device\n",
        "        half_dim = self.dim // 2\n",
        "        emb = math.log(10000) / (half_dim - 1)\n",
        "        emb = torch.exp(torch.arange(half_dim, device=device) * -emb)\n",
        "        emb = x[:, None] * emb[None, :]\n",
        "        emb = torch.cat((emb.sin(), emb.cos()), dim=-1)\n",
        "        return emb\n",
        "\n",
        "class AdaLN(nn.Module):\n",
        "    \"\"\"\n",
        "    Adaptive Layer Normalization.\n",
        "    Predicts Scale and Shift parameters from the condition (Time + Gene Vector).\n",
        "    \"\"\"\n",
        "    def __init__(self, dim, cond_dim):\n",
        "        super().__init__()\n",
        "        self.norm = nn.LayerNorm(dim, elementwise_affine=False)\n",
        "        # Project condition to 2 * dim (Scale + Shift)\n",
        "        self.proj = nn.Sequential(\n",
        "            nn.SiLU(),\n",
        "            nn.Linear(cond_dim, dim * 2)\n",
        "        )\n",
        "        # Zero-initialize the last layer so it starts as an Identity function\n",
        "        nn.init.zeros_(self.proj[1].weight)\n",
        "        nn.init.zeros_(self.proj[1].bias)\n",
        "\n",
        "    def forward(self, x, cond):\n",
        "        # x: (Batch, Seq_Len, Dim)\n",
        "        # cond: (Batch, Cond_Dim)\n",
        "\n",
        "        # Predict scale and shift\n",
        "        scale_shift = self.proj(cond).unsqueeze(1) # (B, 1, 2*Dim)\n",
        "        scale, shift = scale_shift.chunk(2, dim=-1)\n",
        "\n",
        "        # Apply normalization: Norm(x) * (1 + scale) + shift\n",
        "        return self.norm(x) * (1 + scale) + shift\n",
        "\n",
        "class TransformerBlock(nn.Module):\n",
        "    \"\"\"Standard Transformer Block with AdaLN conditioning.\"\"\"\n",
        "    def __init__(self, dim, num_heads, cond_dim, mlp_ratio=4):\n",
        "        super().__init__()\n",
        "        self.attn_norm = AdaLN(dim, cond_dim)\n",
        "        self.attn = nn.MultiheadAttention(dim, num_heads, batch_first=True)\n",
        "\n",
        "        self.mlp_norm = AdaLN(dim, cond_dim)\n",
        "        self.mlp = nn.Sequential(\n",
        "            nn.Linear(dim, dim * mlp_ratio),\n",
        "            nn.GELU(),\n",
        "            nn.Linear(dim * mlp_ratio, dim)\n",
        "        )\n",
        "\n",
        "    def forward(self, x, cond):\n",
        "        # 1. Self-Attention\n",
        "        x_norm = self.attn_norm(x, cond)\n",
        "        attn_out, _ = self.attn(x_norm, x_norm, x_norm)\n",
        "        x = x + attn_out\n",
        "\n",
        "        # 2. Feed Forward\n",
        "        x_norm = self.mlp_norm(x, cond)\n",
        "        x = x + self.mlp(x_norm)\n",
        "        return x\n",
        "\n",
        "class VectorTransformer(nn.Module):\n",
        "    \"\"\"\n",
        "    The Main Model.\n",
        "    Inputs:\n",
        "      - x: STATE Embedding (2058 dims)\n",
        "      - t: Time (0 to 1)\n",
        "      - y_vec: Gene Descriptor (200 dims)\n",
        "    \"\"\"\n",
        "    def __init__(self, input_dim=2058, cond_vec_dim=200, hidden_dim=256, num_layers=6, num_heads=4):\n",
        "        super().__init__()\n",
        "\n",
        "        # Project the input vector (2058) into a token sequence\n",
        "        # We treat the single cell embedding as a sequence of length 1 for simplicity,\n",
        "        # or we could project it to a higher dim. Here we project to hidden_dim.\n",
        "        self.input_proj = nn.Linear(input_dim, hidden_dim)\n",
        "\n",
        "        # Time Embedding\n",
        "        self.time_mlp = nn.Sequential(\n",
        "            SinusoidalPosEmb(hidden_dim),\n",
        "            nn.Linear(hidden_dim, hidden_dim),\n",
        "            nn.SiLU(),\n",
        "            nn.Linear(hidden_dim, hidden_dim)\n",
        "        )\n",
        "\n",
        "        # Gene Vector Projection (200 -> Hidden)\n",
        "        self.gene_vec_proj = nn.Linear(cond_vec_dim, hidden_dim)\n",
        "\n",
        "        # Transformer Layers\n",
        "        self.blocks = nn.ModuleList([\n",
        "            TransformerBlock(hidden_dim, num_heads, cond_dim=hidden_dim)\n",
        "            for _ in range(num_layers)\n",
        "        ])\n",
        "\n",
        "        # Output Projection (Hidden -> 2058)\n",
        "        self.final_norm = AdaLN(hidden_dim, hidden_dim)\n",
        "        self.head = nn.Linear(hidden_dim, input_dim)\n",
        "\n",
        "    def forward(self, x, t, y_vec):\n",
        "        # 1. Prepare Conditioning\n",
        "        t_emb = self.time_mlp(t.squeeze(-1))      # (B, H)\n",
        "        y_emb = self.gene_vec_proj(y_vec)         # (B, H)\n",
        "        cond = t_emb + y_emb                      # Sum Time + Gene info\n",
        "\n",
        "        # 2. Embed Input\n",
        "        # (B, 2058) -> (B, H) -> (B, 1, H) sequence\n",
        "        h = self.input_proj(x).unsqueeze(1)\n",
        "\n",
        "        # 3. Pass through Layers\n",
        "        for block in self.blocks:\n",
        "            h = block(h, cond)\n",
        "\n",
        "        # 4. Final Projection\n",
        "        h = self.final_norm(h, cond)\n",
        "        out = self.head(h)\n",
        "        return out.squeeze(1) # (B, 2058)\n",
        "\n",
        "# ==========================================\n",
        "# 2. Training Logic (Flow Matching)\n",
        "# ==========================================\n",
        "\n",
        "class ConditionalOTTrainer:\n",
        "    def __init__(self, model, control_data, pert_data_dict, gene_vector_map):\n",
        "        self.model = model\n",
        "        self.control_data = control_data\n",
        "        self.pert_data_dict = pert_data_dict\n",
        "        self.gene_vector_map = gene_vector_map\n",
        "        self.labels = list(pert_data_dict.keys())\n",
        "        self.optimizer = torch.optim.Adam(model.parameters(), lr=1e-4)\n",
        "\n",
        "    def train_step(self, batch_size):\n",
        "        self.optimizer.zero_grad()\n",
        "\n",
        "        # 1. Sample a batch of perturbations (Target Genes)\n",
        "        batch_indices = torch.randint(0, len(self.labels), (batch_size,), device=device)\n",
        "        batch_labels = [self.labels[i] for i in batch_indices]\n",
        "\n",
        "        # 2. Gather Data pairs (Target Cell, Gene Vector)\n",
        "        x1_list = []\n",
        "        y_vec_list = []\n",
        "\n",
        "        for label in batch_labels:\n",
        "            # Pick a random cell from this perturbation group\n",
        "            pert_tensor = self.pert_data_dict[label]\n",
        "            rand_idx = torch.randint(0, len(pert_tensor), (1,))\n",
        "            x1_list.append(pert_tensor[rand_idx])\n",
        "\n",
        "            # Get the corresponding 200-dim vector\n",
        "            y_vec_list.append(self.gene_vector_map[label])\n",
        "\n",
        "        x1 = torch.cat(x1_list, dim=0).to(device)       # Target state (Perturbed)\n",
        "        y_vecs = torch.stack(y_vec_list, dim=0).to(device) # Condition\n",
        "\n",
        "        # 3. Sample Source State (Control)\n",
        "        idx_ctrl = torch.randint(0, len(self.control_data), (batch_size,), device=device)\n",
        "        x0 = self.control_data[idx_ctrl]                # Source state\n",
        "\n",
        "        # 4. Sample Time t\n",
        "        t = torch.rand(batch_size, 1, device=device)\n",
        "\n",
        "        # 5. Optimal Transport Interpolation\n",
        "        # x_t = (1 - t) * x0 + t * x1\n",
        "        x_t = (1 - t) * x0 + t * x1\n",
        "\n",
        "        # 6. Target Vector Field (Velocity)\n",
        "        # u_target = x1 - x0\n",
        "        u_target = x1 - x0\n",
        "\n",
        "        # 7. Model Prediction\n",
        "        u_pred = self.model(x_t, t, y_vecs)\n",
        "\n",
        "        # 8. Loss and Update\n",
        "        loss = torch.mean((u_pred - u_target)**2)\n",
        "        loss.backward()\n",
        "        self.optimizer.step()\n",
        "\n",
        "        return loss.item()\n",
        "\n",
        "    def train(self, num_steps, batch_size=128):\n",
        "        self.model.train()\n",
        "        pbar = tqdm(range(num_steps))\n",
        "        for i in pbar:\n",
        "            loss = self.train_step(batch_size)\n",
        "            if i % 100 == 0:\n",
        "                pbar.set_description(f\"Loss: {loss:.4f}\")\n",
        "\n",
        "# ==========================================\n",
        "# 3. Main Script\n",
        "# ==========================================\n",
        "\n",
        "# NOTE: Update this path to your embedded file\n",
        "ADATA_PATH = \"/content/drive/MyDrive/adata_Training_embedded.h5ad\"\n",
        "\n",
        "def main():\n",
        "    print(\"Loading data...\")\n",
        "    try:\n",
        "        adata = sc.read_h5ad(ADATA_PATH)\n",
        "    except FileNotFoundError:\n",
        "        print(f\"Error: Could not find file at {ADATA_PATH}\")\n",
        "        print(\"Please ensure you ran the embedding command from the previous steps.\")\n",
        "        return\n",
        "\n",
        "    # 1. Extract Embeddings and Labels\n",
        "    # X_state should be (N, 2058)\n",
        "    X_emb = adata.obsm['X_state']\n",
        "    target_genes = adata.obs[\"target_gene\"].values\n",
        "\n",
        "    # Identify unique perturbations (exclude controls)\n",
        "    unique_perts = list(set(target_genes) - {\"non-targeting\"})\n",
        "    print(f\"Found {len(unique_perts)} unique perturbations.\")\n",
        "\n",
        "    # 2. Setup Data Tensors\n",
        "    print(\"Preparing tensors...\")\n",
        "\n",
        "    # Control Cells\n",
        "    ctrl_mask = (target_genes == \"non-targeting\")\n",
        "    x_control = torch.tensor(X_emb[ctrl_mask], dtype=torch.float32).to(device)\n",
        "    print(f\"Control cells: {x_control.shape[0]}\")\n",
        "\n",
        "    # Perturbed Cells Dictionary\n",
        "    pert_dict = {}\n",
        "    for p in unique_perts:\n",
        "        mask = (target_genes == p)\n",
        "        if mask.sum() > 0:\n",
        "            pert_dict[p] = torch.tensor(X_emb[mask], dtype=torch.float32).to(device)\n",
        "\n",
        "    # 3. Load Gene Vectors (200 dim)\n",
        "    # REPLACE THIS with your actual loading logic.\n",
        "    # Example: gene_vector_df = pd.read_csv(\"my_gene_vectors.csv\", index_col=0)\n",
        "    print(\"Generating dummy gene vectors (Replace this in production!)\")\n",
        "    gene_vector_map = {}\n",
        "    for p in unique_perts:\n",
        "        # Assuming you have a file, you would look up 'p' in that file here.\n",
        "        # For now, we simulate a random vector.\n",
        "        gene_vector_map[p] = torch.randn(200).to(device)\n",
        "\n",
        "    # 4. Initialize Model\n",
        "    model = VectorTransformer(\n",
        "        input_dim=2058,      # Matches X_state\n",
        "        cond_vec_dim=200,    # Matches your gene vector file\n",
        "        hidden_dim=256,\n",
        "        num_layers=4,\n",
        "        num_heads=4\n",
        "    ).to(device)\n",
        "\n",
        "    # 5. Train\n",
        "    print(\"Starting training...\")\n",
        "    trainer = ConditionalOTTrainer(model, x_control, pert_dict, gene_vector_map)\n",
        "    trainer.train(num_steps=5000, batch_size=128)\n",
        "\n",
        "    # 6. Prediction / Inference Example\n",
        "    print(\"Running simulation for a test gene...\")\n",
        "    test_gene = unique_perts[0]\n",
        "    test_vec = gene_vector_map[test_gene]\n",
        "\n",
