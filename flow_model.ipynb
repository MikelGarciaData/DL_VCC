        "import shutil\n",
        "import os\n",
        "from huggingface_hub import snapshot_download\n",
        "\n",
        "# 1. Clean up the empty/broken directory\n",
        "model_path = \"/content/SE-600M\"\n",
        "if os.path.exists(model_path):\n",
        "    print(f\"Removing incomplete model at {model_path}...\")\n",
        "    shutil.rmtree(model_path)\n",
        "\n",
        "# 2. Re-download the model (this time including the weights!)\n",
        "print(\"Downloading SE-600M weights...\")\n",
        "snapshot_download(\n",
        "    repo_id=\"arcinstitute/SE-600M\",\n",
        "    local_dir=model_path,\n",
        "    local_dir_use_symlinks=False,\n",
        "    # We only exclude the training checkpoint to save space.\n",
        "    # We MUST allow the inference weights to download.\n",
        "    ignore_patterns=[\"se600m_epoch4.ckpt\"],\n",
        ")\n",
