        x0 = x0.cuda()
        x1 = x1.cuda()

        t = torch.rand(x0.shape[0], 1).cuda()
        x_t = (1 - t) * x0 + t * x1

        target_v = x1 - x0
        v_pred = model_fm(x_t, t)

        loss = nn.MSELoss()(v_pred, target_v)

        optimizer.zero_grad()
        loss.backward()
        optimizer.step()

    print(f"Epoch {epoch} | Loss {loss.item():.4f}")

